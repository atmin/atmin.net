{
    "name": "atmin-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:wasm": "cd crypto && wasm-pack build --target web --release && wasm-pack build --target nodejs --release --out-dir pkg-node",
        "test": "vitest run",
        "lint": "biome check src",
        "lint:fix": "biome check --write src",
        "tsc": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.15",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^3.0.6"
    },
    "dependencies": {
        "@scure/bip39": "^2.0.1"
    }
}
